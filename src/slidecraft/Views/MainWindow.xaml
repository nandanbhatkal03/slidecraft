<Window x:Class="slidecraft.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:slidecraft.Views"
        Title="{DynamicResource AppTitle}"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Nirmala UI, Segoe UI, Noto Sans Kannada"
        TextOptions.TextFormattingMode="Ideal"
        Closing="OnWindowClosing">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding AddSlideCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleBoldCommand}" />
        <KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding ToggleItalicCommand}" />
        <KeyBinding Key="F5" Command="{Binding StartSlideshowCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteElementCommand}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True">
        <!-- ═══════════════ MENU BAR ═══════════════ -->
        <Menu DockPanel.Dock="Top" Padding="2">
            <!-- File -->
            <MenuItem Header="{DynamicResource Menu_File}">
                <MenuItem Header="{DynamicResource Cmd_New}"
                          Command="{Binding NewCommand}"
                          InputGestureText="Ctrl+N" />
                <MenuItem Header="{DynamicResource Cmd_Open}"
                          Command="{Binding OpenCommand}"
                          InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="{DynamicResource Cmd_Save}"
                          Command="{Binding SaveCommand}"
                          InputGestureText="Ctrl+S" />
                <MenuItem Header="{DynamicResource Cmd_SaveAs}"
                          Command="{Binding SaveAsCommand}"
                          InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{DynamicResource Cmd_Exit}"
                          Click="OnExitClick" />
            </MenuItem>

            <!-- Insert -->
            <MenuItem Header="{DynamicResource Menu_Insert}">
                <MenuItem Header="{DynamicResource Cmd_TextBox}"
                          Command="{Binding AddTextBoxCommand}" />
                <MenuItem Header="{DynamicResource Cmd_Image}"
                          Command="{Binding AddImageCommand}" />
            </MenuItem>

            <!-- Slide -->
            <MenuItem Header="{DynamicResource Menu_Slide}">
                <MenuItem Header="{DynamicResource Cmd_NewSlide}"
                          Command="{Binding AddSlideCommand}"
                          InputGestureText="Ctrl+M" />
                <MenuItem Header="{DynamicResource Cmd_DuplicateSlide}"
                          Command="{Binding DuplicateSlideCommand}" />
                <MenuItem Header="{DynamicResource Cmd_DeleteSlide}"
                          Command="{Binding DeleteSlideCommand}" />
                <Separator />
                <MenuItem Header="{DynamicResource Cmd_MoveUp}"
                          Command="{Binding MoveSlideUpCommand}" />
                <MenuItem Header="{DynamicResource Cmd_MoveDown}"
                          Command="{Binding MoveSlideDownCommand}" />
            </MenuItem>

            <!-- View -->
            <MenuItem Header="{DynamicResource Menu_View}">
                <MenuItem Header="{DynamicResource Cmd_Slideshow}"
                          Command="{Binding StartSlideshowCommand}"
                          InputGestureText="F5" />
            </MenuItem>

            <!-- Language (Phase 2 placeholder) -->
            <MenuItem Header="{DynamicResource Menu_Language}">
                <MenuItem Header="English"
                          Command="{Binding SwitchLanguageCommand}"
                          CommandParameter="en" />
                <MenuItem Header="ಕನ್ನಡ"
                          Command="{Binding SwitchLanguageCommand}"
                          CommandParameter="kn" />
            </MenuItem>
        </Menu>

        <!-- ═══════════════ TOOLBAR ═══════════════ -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0">
                <!-- File operations -->
                <Button Content="{DynamicResource Cmd_New}"
                        Command="{Binding NewCommand}"
                        ToolTip="{DynamicResource Cmd_New}"
                        MinWidth="50" Padding="6,2" />
                <Button Content="{DynamicResource Cmd_Open}"
                        Command="{Binding OpenCommand}"
                        ToolTip="{DynamicResource Cmd_Open}"
                        MinWidth="50" Padding="6,2" />
                <Button Content="{DynamicResource Cmd_Save}"
                        Command="{Binding SaveCommand}"
                        ToolTip="{DynamicResource Cmd_Save}"
                        MinWidth="50" Padding="6,2" />
                <Separator />

                <!-- Slide -->
                <Button Content="{DynamicResource Cmd_NewSlide}"
                        Command="{Binding AddSlideCommand}"
                        ToolTip="{DynamicResource Cmd_NewSlide}"
                        MinWidth="70" Padding="6,2" />
                <Separator />

                <!-- Insert -->
                <Button Content="T"
                        Command="{Binding AddTextBoxCommand}"
                        ToolTip="{DynamicResource Cmd_TextBox}"
                        FontWeight="Bold" MinWidth="30" Padding="6,2" />
                <Button Content="🖼"
                        Command="{Binding AddImageCommand}"
                        ToolTip="{DynamicResource Cmd_Image}"
                        MinWidth="30" Padding="6,2" />
                <!-- Format (B, I, Size, Color in FormatBar) -->
                <Button Content="B"
                        Command="{Binding ToggleBoldCommand}"
                        ToolTip="{DynamicResource Fmt_Bold}"
                        FontWeight="Bold" MinWidth="30" Padding="6,2" />
                <Button Content="I"
                        Command="{Binding ToggleItalicCommand}"
                        ToolTip="{DynamicResource Fmt_Italic}"
                        FontStyle="Italic" MinWidth="30" Padding="6,2" />
                <Separator />

                <!-- Undo / Redo -->
                <Button Content="{DynamicResource Cmd_Undo}"
                        Command="{Binding UndoCommand}"
                        ToolTip="{DynamicResource Cmd_Undo}"
                        MinWidth="50" Padding="6,2" />
                <Button Content="{DynamicResource Cmd_Redo}"
                        Command="{Binding RedoCommand}"
                        ToolTip="{DynamicResource Cmd_Redo}"
                        MinWidth="50" Padding="6,2" />
                <Separator />

                <!-- Slideshow -->
                <Button Content="{DynamicResource Cmd_Slideshow}"
                        Command="{Binding StartSlideshowCommand}"
                        ToolTip="{DynamicResource Cmd_Slideshow}"
                        MinWidth="70" Padding="6,2" />
            </ToolBar>
        </ToolBarTray>

        <!-- ═══════════════ FORMAT BAR ═══════════════ -->
        <views:FormatBar x:Name="FormatBarControl" DockPanel.Dock="Top"
                         DataContext="{Binding}" Margin="4,0" />

        <!-- ═══════════════ STATUS BAR ═══════════════ -->
        <StatusBar DockPanel.Dock="Bottom" Padding="4,2">
            <StatusBarItem>
                <TextBlock x:Name="StatusSlideInfo" Text="Slide 1 of 1" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusDirty" Text="" />
            </StatusBarItem>
        </StatusBar>

        <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Thumbnails panel -->
                <ColumnDefinition Width="180" MinWidth="120" MaxWidth="300" />
                <!-- Splitter -->
                <ColumnDefinition Width="Auto" />
                <!-- Canvas + controls -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ─── Thumbnail panel ─── -->
            <Border Grid.Column="0" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="0,0,1,0">
                <ListBox x:Name="ThumbnailList"
                         ItemsSource="{Binding Slides}"
                         SelectedItem="{Binding CurrentSlide}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Padding="4"
                         SelectionChanged="OnThumbnailSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#999" BorderThickness="1" Margin="2"
                                    Background="White" Height="90" CornerRadius="2">
                                <TextBlock Text="{Binding SlideNumber}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14" Foreground="#666" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <!-- Right-click context menu -->
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{DynamicResource Cmd_DuplicateSlide}"
                                      Command="{Binding DuplicateSlideCommand}" />
                            <MenuItem Header="{DynamicResource Cmd_DeleteSlide}"
                                      Command="{Binding DeleteSlideCommand}" />
                            <Separator />
                            <MenuItem Header="{DynamicResource Cmd_MoveUp}"
                                      Command="{Binding MoveSlideUpCommand}" />
                            <MenuItem Header="{DynamicResource Cmd_MoveDown}"
                                      Command="{Binding MoveSlideDownCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="#DDD" />

            <!-- ─── Canvas area + bottom controls ─── -->
            <DockPanel Grid.Column="2" LastChildFill="True">

                <!-- Bottom bar: Layout + Transition dropdowns -->
                <Border DockPanel.Dock="Bottom" Background="#F5F5F5"
                        BorderBrush="#CCC" BorderThickness="0,1,0,0"
                        Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Lbl_Layout}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="LayoutCombo" MinWidth="130"
                                  SelectedIndex="2"
                                  SelectionChanged="OnLayoutChanged">
                            <ComboBoxItem Content="{DynamicResource Layout_Title}" Tag="Title" />
                            <ComboBoxItem Content="{DynamicResource Layout_TitleContent}" Tag="TitleContent" />
                            <ComboBoxItem Content="{DynamicResource Layout_Blank}" Tag="Blank" />
                        </ComboBox>

                        <TextBlock Text="{DynamicResource Lbl_Transition}"
                                   VerticalAlignment="Center" Margin="20,0,6,0" />
                        <ComboBox x:Name="TransitionCombo" MinWidth="100"
                                  SelectedIndex="0"
                                  SelectionChanged="OnTransitionChanged">
                            <ComboBoxItem Content="{DynamicResource Trans_None}" Tag="None" />
                            <ComboBoxItem Content="{DynamicResource Trans_Fade}" Tag="Fade" />
                            <ComboBoxItem Content="{DynamicResource Trans_Push}" Tag="Push" />
                            <ComboBoxItem Content="{DynamicResource Trans_Wipe}" Tag="Wipe" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Slide canvas (16:9 inside a Viewbox) -->
                <Border Background="#E8E8E8" Padding="16">
                    <Viewbox Stretch="Uniform">
                        <Border BorderBrush="#AAA" BorderThickness="1"
                                Background="White" Width="960" Height="540">
                            <AdornerDecorator>
                                <Canvas x:Name="SlideCanvas"
                                        Width="960" Height="540"
                                        ClipToBounds="True"
                                        Background="White"
                                        MouseLeftButtonDown="OnCanvasMouseDown" />
                            </AdornerDecorator>
                        </Border>
                    </Viewbox>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
