<Window x:Class="slidecraft.Views.SlideshowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Cmd_Slideshow}"
        WindowState="Maximized"
        WindowStyle="None"
        Background="Black"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseClick"
        Cursor="None">

    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="960" Height="540" Background="White">
            <Canvas x:Name="SlideCanvas" Width="960" Height="540" ClipToBounds="True" />
        </Border>
    </Viewbox>
</Window>
